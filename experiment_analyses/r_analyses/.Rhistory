axis.title.y = element_text(size = 30),
axis.text.x = element_text(size = 20),
axis.text.y = element_text(size = 30)
)
# Create a matrix of counts: rows = groups, columns = correct and incorrect
map_selection <- matrix(c(
17, 3,   # Control: 17 correct, 3 incorrect
16, 4,   # Scrambled Landmarks: 16 correct, 4 incorrect
7, 13    # Scrambled Segments: 7 correct, 13 incorrect
),
nrow = 3, byrow = TRUE)
# Assign row and column names for clarity
rownames(map_selection) <- c("Control", "Scrambled Landmarks", "Scrambled Segments")
colnames(map_selection) <- c("Correct", "Incorrect")
# View the contingency table
print(map_selection)
# Perform chi-square test of independence
chi_sq_test <- chisq.test(map_selection)
# Print test results
print(chi_sq_test)
# Define the groups and counts again for convenience
map_selection <- matrix(c(
17, 3,
16, 4,
7, 13
), nrow = 3, byrow = TRUE)
rownames(map_selection) <- c("Control", "Scrambled Landmarks", "Scrambled Segments")
colnames(map_selection) <- c("Correct", "Incorrect")
# List of group names
groups <- rownames(map_selection)
# Function to perform pairwise Fisher tests
pairwise_fisher <- function(table) {
n <- nrow(table)
p_vals <- matrix(NA, n, n)
rownames(p_vals) <- colnames(p_vals) <- rownames(table)
for(i in 1:(n-1)) {
for(j in (i+1):n) {
# Extract 2x2 table for groups i and j
pair_table <- table[c(i,j), ]
# Fisher's exact test
test <- fisher.test(pair_table)
p_vals[i,j] <- test$p.value
}
}
# Flatten upper triangle and apply Bonferroni correction
raw_p <- na.omit(as.vector(p_vals))
adj_p <- p.adjust(raw_p, method = "bonferroni")
# Put adjusted p-values back in matrix
p_vals[upper.tri(p_vals)] <- adj_p
return(p_vals)
}
# Run pairwise Fisher test
pairwise_results <- pairwise_fisher(map_selection)
print(pairwise_results)
pairwise_results
print(pairwise_results)
# Define the contingency table
map_selection <- matrix(c(
17, 3,
16, 4,
7, 13
), nrow = 3, byrow = TRUE)
rownames(map_selection) <- c("Control", "Scrambled Landmarks", "Scrambled Segments")
colnames(map_selection) <- c("Correct", "Incorrect")
groups <- rownames(map_selection)
# Perform pairwise chi-square tests with reporting
pairwise_chisq_detailed <- function(table) {
n <- nrow(table)
comparisons <- list()
# Collect results in a data frame
results <- data.frame(
Comparison = character(),
X2 = numeric(),
df = integer(),
Raw_p = numeric(),
Adjusted_p = numeric(),
stringsAsFactors = FALSE
)
for(i in 1:(n-1)) {
for(j in (i+1):n) {
group1 <- rownames(table)[i]
group2 <- rownames(table)[j]
pair_table <- table[c(i,j), ]
test <- chisq.test(pair_table, correct = FALSE)
# Store results
results <- rbind(results, data.frame(
Comparison = paste(group1, "vs", group2),
X2 = round(test$statistic, 3),
df = test$parameter,
Raw_p = test$p.value,
Adjusted_p = NA  # Placeholder, will adjust below
))
}
}
# Adjust p-values
results$Adjusted_p <- p.adjust(results$Raw_p, method = "bonferroni")
return(results)
}
# Run the pairwise tests
pairwise_results <- pairwise_chisq_detailed(map_selection)
# Print results
print(pairwise_results)
